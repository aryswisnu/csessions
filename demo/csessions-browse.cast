[2.021, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\u001b[1B\u001b[3G\u001b[0m                                                                                                                                               \u001b[3G  \u001b[;38;5;109m           \u001b[;38;5;209m\u2502\u001b[;38;5;109m today      5.6M tok   \u001b[;38;5;71m~$4\u001b[;38;5;109m                                         \u001b[;38;5;209m\u2502\u001b[1B\u001b[3G\u001b[0m                                                                                                                                               \u001b[3G  \u001b[;38;5;109m           \u001b[;38;5;209m\u2502\u001b[;38;5;109m 7 days    40.2M tok   \u001b[;38;5;71m~$23\u001b[;38;5;109m                                        \u001b[;38;5;209m\u2502\u001b[1B\u001b[3G\u001b[0m                                                                                                                                               \u001b[3G  \u001b[;38;5;109m           \u001b[;38;5;209m\u251c\u2500 \u001b[;38;5;109m\u001b[;38;5;209mLIMITS\u001b[;38;5;109m\u001b[;38;5;209m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\ufffd"]
