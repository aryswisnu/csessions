[8.171, "o", "         \u001b[144G\u001b[0m\u001b[144G \u001b[144G\u001b[1B\u001b[92G\u001b[92G\u001b[92G                                                     \u001b[92G\u001b[1B\u001b[92G\u001b[92G\u001b[;38;5;245m\u2500\u2500\u001b[94G\u001b[;38;5;252m \u001b[95G\u001b[;1;38;5;75myou\u001b[98G\u001b[;38;5;252m \u001b[99G\u001b[;38;5;245m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[126G\u001b[0m\u001b[126G                   \u001b[126G\u001b[1B\u001b[92G\u001b[92G\u001b[;38;5;252;48;5;237m\u276f test_checkout_flow fails maybe 1 run in 5 on CI,  \u001b[144G\u001b[0m\u001b[144G \u001b[144G\u001b[1B\u001b[92G\u001b[92G\u001b[;38;5;252;48;5;237m  never locally                                     \u001b[144G\u001b[0m\u001b[144G \u001b[144G\u001b[1B\u001b[92G\u001b[92G\u001b[92G                                                     \u001b[92G\u001b[1B\u001b[92G\u001b[92G\u001b[;38;5;245m\u2500\u2500\u001b[94G\u001b[;38;5;252m \u001b[95G\u001b[;1;38;5;209mclaude\u001b[101G\u001b[;38;5;252m \u001b[102G\u001b[;38;5;245m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[125G\u001b[0m\u001b[125G                    \u001b[125G\u001b[1B\u001b[92G\u001b[92G\u001b[;38;5;252mIt is a clock race, not a flake in the usual sense.\u001b[143G\u001b[0m\u001b[143G  \u001b[143G\u001b[1B\u001b[92G\u001b[92G\u001b[92G                                             "]
[8.171, "o", "        \u001b[92G\u001b[1B\u001b[92G\u001b[92G\u001b[;38;5;252mThe test seeds an order with \u001b[121G\u001b[;38;5;245mcreated_at = now()\u001b[139G\u001b[;38;5;252m then \u001b[145G\u001b[0m\u001b[145G\u001b[1B\u001b[92G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;5;252m\u001b[94Gasserts it shows in the *last minute* window. CI ru\u001b[145G\u001b[0m\u001b[145G\u001b[1B\u001b[92G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;5;252m\u001b[94Gns the seed and the assert in separate transactions\u001b[145G\u001b[0m\u001b[145G\u001b[1B\u001b[92G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;5;252m\u001b[94G, and Postgres \u001b[109G\u001b[;38;5;245mnow()\u001b[114G\u001b[;38;5;252m is transaction start time, so \u001b[145G\u001b[0m\u001b[145G\u001b[1B\u001b[92G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;5;252m\u001b[94Gon a slow runner the two differ by more than a seco\u001b[145G\u001b[0m\u001b[145G\u001b[1B\u001b[92G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;5;252m\u001b[94Gnd.\u001b[97G\u001b[0m\u001b[97G                                                \u001b[97G\u001b[1B\u001b[92G\u001b[92G\u001b[92G                                                     \u001b[92G\u001b[1B\u001b[92G\u001b[92G\u001b[;38;5;252mFreeze the clock in the fixture rather than widening \u001b[145G\u001b[0m\u001b[145G\u001b[1B\u001b[92G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;5;252m\u001b[94Gthe window.\u001b[105G\u001b[0m\u001b[105G                               "]
