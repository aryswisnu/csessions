[15.157, "o", "48;5;237m  but not staging                              \u001b[130G\u001b[0m\u001b[130G \u001b[130G\u001b[1B\u001b[83G\u001b[83G\u001b[83G                                                \u001b[83G\u001b[1B\u001b[83G\u001b[83G\u001b[;38;5;245m\u2500\u2500\u001b[85G\u001b[;38;5;252m \u001b[86G\u001b[;1;38;5;209mclaude\u001b[92G\u001b[;38;5;252m \u001b[93G\u001b[;38;5;245m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[111G\u001b[0m\u001b[111G                    \u001b[111G\u001b[1B\u001b[83G\u001b[83G\u001b[;38;5;252mStaging has no load balancer in front of it. Tha\u001b[131G\u001b[0m\u001b[131G\u001b[1B\u001b[83G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;5;252m\u001b[85Gt is the whole difference.\u001b[111G\u001b[0m\u001b[111G                    \u001b[111G\u001b[1B\u001b[83G\u001b[83G\u001b[83G                                                \u001b[83G\u001b[1B\u001b[83G\u001b[83G\u001b[;38;5;252mThe ALB idle timeout is 30s and an SSE stream th\u001b[131G\u001b[0m\u001b[131G\u001b[1B\u001b[83G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;5;252m\u001b[85Gat is merely *open* with no bytes flowing coun\u001b[131G\u001b[0m\u001b[131G\u001b[1B\u001b[83G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;5;252m\u001b[85Gts as idle. The server never sends a heartbeat\u001b[131G\u001b[0m\u001b[131G\u001b[1B\u001b[83G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;5;252m\u001b[85G, so the ALB closes it and the client r"]
[15.157, "o", "econnec\u001b[131G\u001b[0m\u001b[131G\u001b[1B\u001b[83G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;5;252m\u001b[85Gts.\u001b[88G\u001b[0m\u001b[88G                                           \u001b[88G\u001b[1B\u001b[83G\u001b[83G\u001b[83G                                                \u001b[83G\u001b[1B\u001b[83G\u001b[83G\u001b[;38;5;252mSend a \u001b[90G\u001b[;38;5;245m: ping\u001b[96G\u001b[;38;5;252m comment line every 15s. One line o\u001b[131G\u001b[0m\u001b[131G\u001b[1B\u001b[83G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;5;252m\u001b[85Gf server code.\u001b[99G\u001b[0m\u001b[99G                                \u001b[99G\u001b[1B\u001b[83G\u001b[83G\u001b[83G                                                \u001b[83G\u001b[1B\u001b[83G\u001b[83G\u001b[;38;5;245m\u2500\u2500\u001b[85G\u001b[;38;5;252m \u001b[86G\u001b[;1;38;5;75myou\u001b[89G\u001b[;38;5;252m \u001b[90G\u001b[;38;5;245m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[112G\u001b[0m\u001b[112G                   \u001b[112G\u001b[1B\u001b[83G\u001b[83G\u001b[;38;5;252;48;5;237m\u276f is a comment line safe for all clients?      \u001b[130G\u001b[0m\u001b[130G \u001b[130G\u001b[1B\u001b[83G\u001b[83G                                                \u001b[83G\u001b[1B\u001b[83G                                                \u001b[83G\u001b[1B\u001b[83G                                                \u001b[83G"]
