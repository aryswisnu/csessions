[7.034, "o", "[130G\u001b[0m\u001b[130G \u001b[130G\u001b[1B\u001b[83G\u001b[83G\u001b[;38;5;252;48;5;237m  can we just drop it?                         \u001b[130G\u001b[0m\u001b[130G \u001b[130G\u001b[1B\u001b[83G\u001b[83G\u001b[83G                                                \u001b[83G\u001b[1B\u001b[83G\u001b[83G\u001b[;38;5;245m\u2500\u2500\u001b[85G\u001b[;38;5;252m \u001b[86G\u001b[;1;38;5;209mclaude\u001b[92G\u001b[;38;5;252m \u001b[93G\u001b[;38;5;245m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[111G\u001b[0m\u001b[111G                    \u001b[111G\u001b[1B\u001b[83G\u001b[83G\u001b[;38;5;252mYes. The queue only ever retries on \u001b[119G\u001b[;38;5;245m502\u001b[122G\u001b[;38;5;252m and \u001b[127G\u001b[;38;5;245m504\u001b[130G\u001b[;38;5;252m,\u001b[131G\u001b[0m\u001b[131G\u001b[1B\u001b[83G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;5;252m\u001b[85G and the gateway already retries those itself \u001b[131G\u001b[0m\u001b[131G\u001b[1B\u001b[83G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;5;252m\u001b[85Gbefore we see them.\u001b[104G\u001b[0m\u001b[104G                           \u001b[104G\u001b[1B\u001b[83G\u001b[83G\u001b[83G                                                \u001b[83G\u001b[1B\u001b[83G\u001b[83G\u001b[;38;5;252mSo every queued job is a \u001b[108G\u001b[;1;38;5;252msecond\u001b[114G\u001b[;38;5;252m retry of somethi\u001b[131G\u001b[0m\u001b[131G\u001b[1B\u001b[83G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;"]
[7.034, "o", "5;252m\u001b[85Gng that was retried once. That is where the du\u001b[131G\u001b[0m\u001b[131G\u001b[1B\u001b[83G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;5;252m\u001b[85Gplicate charges came from.\u001b[111G\u001b[0m\u001b[111G                    \u001b[111G\u001b[1B\u001b[83G\u001b[83G\u001b[83G                                                \u001b[83G\u001b[1B\u001b[83G\u001b[83G\u001b[;38;5;209m\u2022\u001b[84G\u001b[;38;5;252m \u001b[85G\u001b[;38;5;245mRetryQueue\u001b[95G\u001b[;38;5;252m and its table go\u001b[112G\u001b[0m\u001b[112G                   \u001b[112G\u001b[1B\u001b[83G\u001b[83G\u001b[;38;5;209m\u2022\u001b[84G\u001b[;38;5;252m \u001b[85G\u001b[;38;5;245mBillingAdapter.submit\u001b[106G\u001b[;38;5;252m calls the gateway direct\u001b[131G\u001b[0m\u001b[131G\u001b[1B\u001b[83G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;5;252m\u001b[85Gly\u001b[87G\u001b[0m\u001b[87G                                            \u001b[87G\u001b[1B\u001b[83G\u001b[83G\u001b[;38;5;209m\u2022\u001b[84G\u001b[;38;5;252m the \u001b[89G\u001b[;38;5;245mbilling_retry_depth\u001b[108G\u001b[;38;5;252m metric goes with it\u001b[128G\u001b[0m\u001b[128G   \u001b[128G\u001b[1B\u001b[83G\u001b[83G\u001b[83G                                                \u001b[83G\u001b[1B\u001b[83G\u001b[83G\u001b[;38;5;252mAbout 180 lines deleted, nothing added.\u001b[122G\u001b[0m\u001b[122G         \u001b[122G\u001b[1B\u001b[83G\u001b[83G\u001b[83G                        "]
