[2.021, "o", "                                              \u001b[3G  \u001b[;38;5;109m           \u001b[;38;5;209m\u251c\u2500 \u001b[;38;5;109m\u001b[;38;5;209mNEW\u001b[;38;5;109m\u001b[;38;5;209m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\u001b[1B\u001b[3G\u001b[0m                                                                                                                                               \u001b[3G  \u001b[;38;5;109m           \u001b[;38;5;209m\u2502\u001b[;38;5;109m \u001b[;38;5;209m+ New session\u001b[;38;5;109m   (click, or ctrl-n)                                \u001b[;38;5;209m\u2502\u001b[1B\u001b[3G\u001b[0m                                                                                                                                               \u001b[3G  \u001b[;38;5;109m           \u001b[;38;5;209m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\ufffd"]
