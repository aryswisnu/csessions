[8.137, "o", "1B\u001b[83G\u001b[83G\u001b[;38;5;252mThe test seeds an order with \u001b[112G\u001b[;38;5;245mcreated_at = now()\u001b[130G\u001b[;38;5;252m \u001b[131G\u001b[0m\u001b[131G\u001b[1B\u001b[83G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;5;252m\u001b[85Gthen asserts it shows in the *last minute* win\u001b[131G\u001b[0m\u001b[131G\u001b[1B\u001b[83G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;5;252m\u001b[85Gdow. CI runs the seed and the assert in separa\u001b[131G\u001b[0m\u001b[131G\u001b[1B\u001b[83G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;5;252m\u001b[85Gte transactions, and Postgres \u001b[115G\u001b[;38;5;245mnow()\u001b[120G\u001b[;38;5;252m is transac\u001b[131G\u001b[0m\u001b[131G\u001b[1B\u001b[83G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;5;252m\u001b[85Gtion start time, so on a slow runner the two d\u001b[131G\u001b[0m\u001b[131G\u001b[1B\u001b[83G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;5;252m\u001b[85Giffer by more than a second.\u001b[113G\u001b[0m\u001b[113G                  \u001b[113G\u001b[1B\u001b[83G\u001b[83G\u001b[83G                                                \u001b[83G\u001b[1B\u001b[83G\u001b[83G\u001b[;38;5;252mFreeze the clock in the fixture rather than wide\u001b[131G\u001b[0m\u001b[131G\u001b[1B\u001b[83G\u001b[;38;5;252m\u001b[2m\u21b3 \u001b[;38;5;252m\u001b[85Gning the window.\u001b[101G\u001b[0m\u001b[101G                              \u001b[101G\u001b[1B\u001b[83G\u001b[83G                            "]
