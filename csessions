#!/usr/bin/env python3
"""Claude Code sessions from this Mac and remote hosts, in one interactive list.

Usage: csessions        picker: click = preview, double-click / Enter = open
       csessions -l     plain table (also used when output is piped)
       -a               include completed sessions

Keys:  ctrl-n new session   ctrl-r refresh now   esc quit
       the [ + New session ] header is clickable
"""
import json, os, re, shlex, shutil, socket, subprocess, sys, tempfile, textwrap, threading, time, urllib.request
from concurrent.futures import ThreadPoolExecutor

CONFIG = os.path.expanduser(
    os.environ.get("CSESSIONS_CONFIG", "~/.config/csessions/config.json"))
DEFAULTS = {
    "hosts": {"local": None},   # label -> ssh target, null meaning this machine
    "prefixes": {},             # label -> text prepended to that host's titles
    "refresh": 5,
    "history_ttl": 180,
    "preview_width": 40,
    "terminal": "iTerm",
    # optional keystroke sent after a session window opens, to hand it to a
    # tiling tool: {"key_code": 17, "modifiers": ["control","option","command"]}
    "tile_shortcut": None,
}


def config():
    cfg = dict(DEFAULTS)
    try:
        with open(CONFIG) as f:
            cfg.update(json.load(f))
    except FileNotFoundError:
        pass
    except Exception as exc:
        print(f"csessions: ignoring {CONFIG}: {exc}", file=sys.stderr)
    return cfg


CFG = config()
HOSTS = CFG["hosts"]
TERMINAL = CFG["terminal"]
SSH = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8"]
REFRESH = CFG["refresh"]
SNAP = os.path.join(tempfile.gettempdir(), "csessions-rows.json")
BUSY = SNAP + ".lock"
PREFIX = CFG["prefixes"]
HIST_TTL = CFG["history_ttl"]

BAND = "\033[48;5;237m"
R, B, DIM, REV = "\033[0m", "\033[1m", "\033[2m", "\033[7m"
ORANGE, BLUE, GREY, CYAN = "\033[38;5;209m", "\033[38;5;75m", "\033[38;5;245m", "\033[36m"
GREEN, YELLOW = "\033[38;5;71m", "\033[38;5;179m"


def run(label, cmd, timeout=30):
    """Run a shell command on a host through a login shell, return stdout."""
    target = HOSTS[label]
    argv = ["bash", "-lc", cmd] if target is None else SSH + [target, "bash -lc " + shlex.quote(cmd)]
    return subprocess.run(argv, capture_output=True, text=True, timeout=timeout).stdout


def account():
    try:
        with open(os.path.expanduser("~/.claude.json")) as f:
            return json.load(f).get("oauthAccount", {}).get("emailAddress", "") or os.getlogin()
    except Exception:
        return os.getlogin()


def fetch(label, flags):
    try:
        out = run(label, f"claude agents {flags}")
        rows = [dict(s, host=label) for s in json.loads(out[out.index("["):])]
        st = live_state(label)
        return [dict(s, rc=st.get(s.get("sessionId", ""), (False, 0))[0],
                     last=st.get(s.get("sessionId", ""), (False, 0))[1] or s.get("startedAt", 0))
                for s in rows]
    except Exception as e:  # unreachable host must not hide the others
        print(f"! {label}: {type(e).__name__}", file=sys.stderr)
        return []


# Each live claude process writes ~/.claude/sessions/<pid>.json; a string
# bridgeSessionId there means the session is attached to Remote Control.
# The file outlives a hard kill, so the pid must still be alive to count.
RC_PROBE = r'''python3 -c "
import json,glob,os
for f in glob.glob(os.path.expanduser(chr(126)+'/.claude/sessions/*.json')):
    try: d=json.load(open(f))
    except Exception: continue
    p=d.get('pid'); sid=d.get('sessionId')
    if not p or not sid: continue
    try: os.kill(int(p),0)
    except Exception: continue
    rc='1' if isinstance(d.get('bridgeSessionId'),str) else '0'
    print(chr(9).join([sid,rc,str(d.get('updatedAt') or d.get('startedAt') or 0)]))"'''


# Closed sessions leave no daemon record, only a transcript. Name comes from the
# last custom-title/ai-title line; mtime is when it was last touched.
HISTORY_PROBE = r'''python3 -c "
import json,glob,os
for f in glob.glob(os.path.expanduser(chr(126)+'/.claude/projects/*/*.jsonl')):
    sid=os.path.basename(f)[:-6]; name=''; cwd=''
    try:
        for line in open(f,errors='ignore'):
            if 'title' not in line and 'cwd' not in line: continue
            try: d=json.loads(line)
            except Exception: continue
            name=d.get('customTitle') or d.get('aiTitle') or name
            cwd=d.get('cwd') or cwd
    except Exception: continue
    print(chr(9).join([sid,str(int(os.path.getmtime(f)*1000)),name,cwd]))"'''


def history(label):
    """Closed sessions this host still has transcripts for (cached: the scan
    walks every transcript on the host and costs seconds, the 5s refresh cannot
    pay that). Closed sessions do not change often, so a stale few minutes is fine."""
    cache = os.path.join(tempfile.gettempdir(), f"csessions-history-{label}.json")
    try:
        if time.time() - os.path.getmtime(cache) < HIST_TTL:
            with open(cache) as f:
                return json.load(f)
    except Exception:
        pass
    out = []
    try:
        for l in run(label, HISTORY_PROBE, timeout=40).splitlines():
            p = l.split("\t")
            if len(p) == 4 and p[0]:
                out.append({"sessionId": p[0], "startedAt": int(p[1]), "last": int(p[1]),
                            "name": p[2] or None, "cwd": p[3] or "~", "host": label,
                            "kind": "closed", "state": "-"})
    except Exception:
        pass
    try:
        with open(cache, "w") as f:
            json.dump(out, f)
    except Exception:
        pass
    return out


def live_state(label):
    """sessionId -> (remote-controlled, last-activity ms) for this host's live sessions."""
    got = {}
    try:
        for l in run(label, RC_PROBE, timeout=15).splitlines():
            f = l.split("\t")
            if len(f) == 3 and f[0]:
                got[f[0]] = (f[1] == "1", int(f[2] or 0))
    except Exception:
        pass
    return got


def age(ms):
    m = int(time.time() - ms / 1000) // 60
    return f"{m}m" if m < 60 else f"{m // 60}h" if m < 2880 else f"{m // 1440}d"


def md(text, width):
    """Render a useful subset of markdown to ANSI: headings, bullets, code, emphasis."""
    out, fence = [], False
    for line in text.splitlines():
        if line.lstrip().startswith("```"):
            fence = not fence
            out.append(f"{GREY}{'─' * min(width, 30)}{R}")
            continue
        if fence:
            out.append(f"{GREY}  {line}{R}")
            continue
        s = line.rstrip()
        for mark, code in (("**", B), ("`", GREY)):  # paired inline marks, longest first
            parts = s.split(mark)
            if len(parts) > 2:
                s = "".join(p if n % 2 == 0 else f"{code}{p}{R}" for n, p in enumerate(parts))
        if s.startswith("#"):
            s = f"{B}{CYAN}{s.lstrip('#').strip()}{R}"
        elif s.lstrip().startswith(("- ", "* ")):
            i = len(s) - len(s.lstrip())
            s = f"{' ' * i}{ORANGE}•{R} {s.lstrip()[2:]}"
        out.append(s)
    return "\n".join(out)


# A transcript turn is not just what someone typed: slash commands, their output,
# caveats and system reminders are all injected as "user" text. Shown raw they
# drown the actual conversation, so each is either relabelled or dropped.
DROP = re.compile(r"<(system-reminder|local-command-caveat|command-message|command-args)>"
                  r".*?</\1>\s*", re.S)
CMD = re.compile(r"<command-name>\s*(.*?)\s*</command-name>\s*", re.S)
STDOUT = re.compile(r"<local-command-stdout>\s*(.*?)\s*</local-command-stdout>\s*", re.S)


def clean_turn(text):
    """Return (chips, body). Chips are slash commands run this turn."""
    chips = [c.strip() for c in CMD.findall(text) if c.strip()]
    outs = [o.strip() for o in STDOUT.findall(text) if o.strip()]
    body = STDOUT.sub("", CMD.sub("", DROP.sub("", text))).strip()
    if outs and not body:
        body = outs[0]
    return chips, body


def rule(width, label=""):
    if not label:
        return f"{GREY}{'─' * width}{R}"
    return f"{GREY}{'─' * 2}{R} {label} {GREY}{'─' * max(0, width - len(label) - 4)}{R}"


def preview(host, kind, state, sid, cwd, name="-"):
    if kind == "heading":
        print(f"{DIM}Sessions last active {name}.{R}")
        return
    width = max(20, int(os.environ.get("FZF_PREVIEW_COLUMNS", 60)) - 1)
    where = "this Mac" if host == "mac" else host
    # fzf cannot bind a click inside the preview pane, so the key is the button
    close = f"{GREY}ESC{R} {DIM}or{R} {GREY}←{R} {DIM}to close{R}"
    # sits above the title, hard left: fzf paints its own scroll indicator in
    # the preview's top-right corner and would overwrite anything placed there
    print(close)
    shown = name if len(name) <= width else name[:max(1, width - 1)] + "…"
    print(f"{B}{shown}{R}")
    print(f"{DIM}{state} {kind} on {where}{R}")
    print(f"{GREY}{cwd}{R}")
    print(f"{GREY}{sid[:8]}{R}")
    # transcript lives under a sanitized-cwd dir, glob avoids re-deriving that name
    out = run(host, f"tail -n 120 ~/.claude/projects/*/{shlex.quote(sid)}.jsonl")
    msgs = []
    for line in out.splitlines():
        try:
            d = json.loads(line)
            c = d["message"]["content"]
        except (ValueError, KeyError, TypeError):
            continue
        if isinstance(c, list):
            c = "\n".join(b.get("text", "") for b in c
                          if isinstance(b, dict) and b.get("type") == "text")
        # isMeta marks text the harness injected (skill bodies, command output
        # preambles) rather than anything a person or Claude actually said
        if d.get("isMeta") or d.get("isSidechain"):
            continue
        if d.get("type") not in ("user", "assistant") or not c.strip():
            continue
        chips, body = clean_turn(c)
        if chips or body:
            msgs.append((d["type"], chips, body))
    if not msgs:
        print(f"\n{rule(width)}\n{DIM}Nothing said in this session yet.{R}")
        return
    for who, chips, body in msgs[-5:]:
        you = who == "user"
        tint, label = (BLUE, "you") if you else (ORANGE, "claude")
        print()
        print(rule(width, f"{B}{tint}{label}{R}"))
        for c in chips:
            t = f"❯ {c}"
            print(f"{BAND}{B}{t}{R}{BAND}{' ' * max(0, width - len(t))}{R}")
        if not body:
            continue
        if you:   # wrap ourselves so the quote bar runs down every line
            lines = []
            for para in body.splitlines():
                lines += textwrap.wrap(para, max(10, width - 2)) or [""]
        else:
            lines = md(body, width).splitlines()
        cap = 6 if you else 10
        for i, l in enumerate(lines[:cap]):
            if you:
                t = ("❯ " if i == 0 else "  ") + l
                print(f"{BAND}{t}{' ' * max(0, width - len(t))}{R}")
            else:
                print(l)
        if len(lines) > cap:
            print(f"{GREY}  +{len(lines) - cap} more lines{R}")


def open_session(host, kind, state, sid, cwd):
    if kind == "heading":       # a group label, nothing to open
        return
    # background sessions stay registered even once done, and --resume refuses
    # them outright ("Run `claude attach <id>`"), so they always attach
    if kind == "background":
        cmd = f"claude attach {shlex.quote(sid[:8])}"
    else:
        cmd = f"cd {shlex.quote(cwd)} && claude --resume {shlex.quote(sid)}"
    in_new_window(host, cmd)
    tile_windows(2.5)


def exec_on(host, cmd):
    """Replace this process with cmd, so it takes over the current window."""
    target = HOSTS[host]
    argv = ["bash", "-lc", cmd] if target is None else ["ssh", "-t", target, "bash -lc " + shlex.quote(cmd)]
    os.execvp(argv[0], argv)


def as_applescript(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def in_new_window(host, cmd):
    """Run cmd in a fresh terminal window, leaving this picker running."""
    target = HOSTS[host]
    full = cmd if target is None else f"ssh -t {target} {shlex.quote('bash -lc ' + shlex.quote(cmd))}"
    # hold the window open on failure, otherwise it vanishes before the error is readable
    full += '; ec=$?; [ $ec -ne 0 ] && { echo; echo "[exited $ec] press any key"; read -n 1 -s; }'
    inner = f"/bin/bash -lc {shlex.quote(full)}"
    subprocess.run(["osascript", "-e", f'''
tell application "{TERMINAL}"
\tcreate window with default profile command {as_applescript(inner)}
\tactivate
end tell'''], capture_output=True)


def pick_one(menu, prompt, header, nth="1,2"):
    return subprocess.run(
        ["fzf", "--delimiter=\t", f"--with-nth={nth}", "--no-sort", "--reverse", "--ansi",
         "--height=~14", "--pointer=→", "--highlight-line", "--border=rounded",
         f"--prompt={prompt}", f"--header={header}"],
        input=menu, stdout=subprocess.PIPE, text=True).stdout.strip()


def new_session(rows):
    """Ask which host, then which directory, then start a Remote Control session.
    Runs inside the freshly opened window, so the picker is never taken over."""
    menu = "\n".join(f"{h}\t{'this Mac' if t is None else t}" for h, t in HOSTS.items())
    pick = pick_one(menu, "work where? ", "start a new Remote Control session on:")
    if not pick:
        return
    host = pick.split("\t")[0]
    # history is per-directory, so offer the dirs this host actually has sessions in
    seen, dirs = set(), []
    for s in rows:
        c = s.get("cwd")
        if s.get("host") == host and c and c not in seen:
            seen.add(c)
            dirs.append(c)
    home = "~" if host != "mac" else os.path.expanduser("~")
    if home not in seen:
        dirs.append(home)
    menu = "\n".join(f"{c}\t{sum(1 for s in rows if s.get('cwd') == c and s.get('host') == host)} sessions"
                     for c in dirs)
    pick = pick_one(menu, "which folder? ", f"new session on {host} — pick a working directory:")
    if not pick:
        return
    cwd = pick.split("\t")[0]
    tile_windows()   # grid it before exec replaces this process
    # --remote-control makes it reachable from claude.ai/code and the mobile app
    exec_on(host, f"cd {shlex.quote(cwd)} && claude --remote-control")


def tile_windows(delay=1.5):
    """Hand a freshly opened window to a tiling tool, if tile_shortcut is set.
    Off by default: it types a keystroke, which needs Accessibility permission
    for the terminal. A refusal is reported, never fatal."""
    shortcut = CFG.get("tile_shortcut")
    if not shortcut:
        return
    mods = ", ".join(f"{m} down" for m in shortcut.get("modifiers", []))
    using = f" using {{{mods}}}" if mods else ""
    time.sleep(delay)
    r = subprocess.run(
        ["osascript", "-e",
         f'tell application "{TERMINAL}" to activate\n'
         'delay 0.3\n'
         f'tell application "System Events" to key code {int(shortcut["key_code"])}{using}'],
        capture_output=True, text=True)
    if r.returncode:
        print(f"tile: {r.stderr.strip()[:120]}", file=sys.stderr)


