def plan():
    """Subscription tier, as shown on claude.ai."""
    try:
        with open(os.path.expanduser("~/.claude.json")) as f:
            oa = json.load(f).get("oauthAccount", {})
        t = (oa.get("userRateLimitTier") or oa.get("organizationRateLimitTier") or
             oa.get("organizationType") or "")
        for needle, label in (("max_20x", "Max 20x"), ("max_5x", "Max 5x"),
                              ("max", "Max"), ("pro", "Pro"), ("team", "Team")):
            if needle in t:
                return label
        return t or "unknown plan"
    except Exception:
        return "unknown plan"


def version():
    try:
        out = subprocess.run(["claude", "--version"], capture_output=True, text=True, timeout=10).stdout
        return out.split()[0] if out.strip() else "?"
    except Exception:
        return "?"


RED, ORANGE2, LIME = "\033[38;5;203m", "\033[38;5;215m", "\033[38;5;149m"


def usage_hue(p):
    """Same ramp the statusline uses, so the two never disagree."""
    return RED if p >= 95 else ORANGE2 if p >= 85 else YELLOW if p >= 70 else LIME if p >= 50 else GREEN


def bar(pct, n=12):
    fill = max(0, min(n, int(round(pct / 100 * n))))
    hue = usage_hue(pct)
    return f"{hue}{'█' * fill}{GREY}{'░' * (n - fill)}{R}", hue


# USD per million tokens: input, output, cache write (5m), cache read.
PRICES = {
    "fable-5-1": (10.0, 50.0, 12.50, 0.25), "fable-5": (10.0, 50.0, 12.50, 1.00),
    "opus-5": (5.0, 25.0, 6.25, 0.50), "opus-4-8": (5.0, 25.0, 6.25, 0.50),
    "opus-4-7": (5.0, 25.0, 6.25, 0.50), "opus-4-6": (5.0, 25.0, 6.25, 0.50),
    "sonnet-5": (2.0, 10.0, 2.50, 0.20), "sonnet-4-6": (3.0, 15.0, 3.75, 0.30),
    "haiku-4-5": (1.0, 5.0, 1.25, 0.10),
}
DEFAULT_PRICE = PRICES["opus-5"]

# Sum token usage per day from the transcripts. Only files touched in the last
# 8 days are opened, which keeps this to a fraction of the full history scan.
USAGE_PROBE = r'''python3 -c "
import json,glob,os,time,calendar
cut=time.time()-8*86400
for f in glob.glob(os.path.expanduser(chr(126)+'/.claude/projects/*/*.jsonl')):
    try:
        if os.path.getmtime(f)<cut: continue
    except Exception: continue
    try:
        for line in open(f,errors='ignore'):
            if 'usage' not in line or 'assistant' not in line: continue
            try: d=json.loads(line)
            except Exception: continue
            m=d.get('message') or {}
            u=m.get('usage') or {}
            if not u: continue
            ts=d.get('timestamp') or ''
            try: ep=calendar.timegm(time.strptime(ts[:19],'%Y-%m-%dT%H:%M:%S'))
            except Exception: continue
            print(chr(9).join([str(ep),str(m.get('model') or ''),
                str(u.get('input_tokens') or 0),str(u.get('output_tokens') or 0),
                str(u.get('cache_creation_input_tokens') or 0),
                str(u.get('cache_read_input_tokens') or 0)]))
    except Exception: continue"'''


def spend(label):
    """(day -> [tokens, usd]) for this host, cached like the history scan."""
    cache = os.path.join(tempfile.gettempdir(), f"csessions-spend-{label}.json")
    try:
        if time.time() - os.path.getmtime(cache) < HIST_TTL:
            with open(cache) as f:
                return json.load(f)
    except Exception:
        pass
    days = {}
    try:
        for l in run(label, USAGE_PROBE, timeout=90).splitlines():
            p = l.split("\t")
            if len(p) != 6 or not p[0]:
                continue
            inp, out, cw, cr = (int(x or 0) for x in p[2:])
            price = next((v for k, v in PRICES.items() if k in p[1]), DEFAULT_PRICE)
            usd = (inp * price[0] + out * price[1] + cw * price[2] + cr * price[3]) / 1e6
            day = time.strftime("%Y-%m-%d", time.localtime(int(p[0])))
            d = days.setdefault(day, [0, 0.0])
            d[0] += inp + out + cw + cr
            d[1] += usd
    except Exception:
        pass
    try:
        with open(cache, "w") as f:
            json.dump(days, f)
    except Exception:
        pass
    return days


def human(n):
    for unit, size in (("B", 1e9), ("M", 1e6), ("K", 1e3)):
        if n >= size:
            return f"{n / size:.1f}{unit}"
    return str(int(n))


def stats_rows():
    days = {}
    with ThreadPoolExecutor() as ex:
        for got in ex.map(spend, HOSTS):
            for k, v in got.items():
                d = days.setdefault(k, [0, 0.0])
                d[0] += v[0]
                d[1] += v[1]
    today = time.strftime("%Y-%m-%d")
    week = [time.strftime("%Y-%m-%d", time.localtime(time.time() - i * 86400)) for i in range(7)]
    rows = []
    for tag, keys in (("today", [today]), ("7 days", week)):
        tok = sum(days.get(k, [0, 0])[0] for k in keys)
        usd = sum(days.get(k, [0, 0.0])[1] for k in keys)
        plain = f"{tag:<7} {human(tok):>7} tok   ~${usd:,.0f}"
        rows.append((plain, f"{DIM}{tag:<7}{R} {B}{human(tok):>7}{R}{DIM} tok   {R}"
                            f"{GREEN}~${usd:,.0f}{R}"))
    return rows


def limits_line():
    """5H / 7D usage. The payload only reaches a statusline, so statusline.py
    caches it to ~/.claude/rate-limits.json and we read that."""
    try:
        with open(os.path.expanduser("~/.claude/rate-limits.json")) as f:
            rl = json.load(f)
    except Exception:
        return "limits unavailable", f"{DIM}limits unavailable{R}"
    rows = []
    for key, tag in (("five_hour", "5H"), ("seven_day", "7D")):
        d = rl.get(key)
        if not d:
            continue
        pct = int(d.get("used_percentage") or 0)
        left = int((d.get("resets_at") or 0) - time.time())
        when = f"{left // 3600:02d}:{left % 3600 // 60:02d}" if 0 < left < 86400 else (
            time.strftime("%b %-d %H:%M", time.localtime(d["resets_at"]))
            if d.get("resets_at") else "")
        g, hue = bar(pct)
        plain = f"{tag} {'█' * 12} {pct:>3}%  {when}"
        rows.append((plain, f"{DIM}{tag}{R} {g} {hue}{pct:>3}%{R}  {GREY}{when}{R}"))
    return rows or [("limits unavailable", f"{DIM}limits unavailable{R}")]


ANSI = re.compile(r"\033\[[0-9;]*m")


def vlen(s):
    """Width on screen, ignoring colour codes."""
    return len(ANSI.sub("", s))


def vcut(s, limit):
    """Truncate to `limit` visible characters without slicing an escape in half."""
    out, shown, i = [], 0, 0
    while i < len(s) and shown < limit:
        m = ANSI.match(s, i)
        if m:
            out.append(m.group())
            i = m.end()
            continue
        out.append(s[i])
        shown += 1
        i += 1
    return "".join(out) + R


def panel(width, sections):
    """Framed box with an inset label per section, like the statusline."""
    lines = []
    for i, (label, rows) in enumerate(sections):
        l, r = ("╭", "╮") if i == 0 else ("├", "┤")
        lines.append(f"{ORANGE}{l}─ {B}{label}{R}{ORANGE} "
                     f"{'─' * max(0, width - 5 - len(label))}{r}{R}")
        for _plain, colored in rows:
            room = width - 3
            if vlen(colored) > room:              # never let content break the frame
                colored = vcut(colored, room - 1) + f"{GREY}…{R}"
            lines.append(f"{ORANGE}│{R} {colored}"
                         f"{' ' * max(0, room - vlen(colored))}{ORANGE}│{R}")
    lines.append(f"{ORANGE}╰{'─' * (width - 2)}╯{R}")
    return lines


# Column header. Every width here must match the row format in rows_to_lines:
# status glyph sits under the blank, ◉ under the R of RC, then one space per gap.
# One card per session, grouped by when it was last active. The card text
# carries no colour of its own: fzf then paints the whole selected card orange
# (fg+) and the rest white (fg), which embedded ANSI would override.
HEADER_COLS = f"{DIM}  sessions, most recently active first{R}"


def bucket(ms):
    """Which day group a timestamp belongs to, in the viewer's own timezone."""
    day = time.strftime("%Y-%m-%d", time.localtime(ms / 1000))
    today = time.strftime("%Y-%m-%d")
    yesterday = time.strftime("%Y-%m-%d", time.localtime(time.time() - 86400))
    if day == today:
        return "today"
    if day == yesterday:
        return "yesterday"
    if ms / 1000 > time.time() - 7 * 86400:
        return "earlier this week"
    return "older"


def rows_to_lines(rows):
    items, group = [], None
    hostw = max([len(h) for h in HOSTS] + [4]) + 1
    for s in rows:
        st = s.get("state") or "-"
        kind = s.get("kind") or "?"
        # state is a glyph, not a colour, so it survives fzf recolouring the line
        # a working session pulses: terminal blink animates continuously without
        # the 5s refresh having to repaint. The escape ends before the title, so
        # fzf can still recolour the title when the card is selected.
        mark = "✳" if st == "working" else "◐" if st == "blocked" else "○"
        rc = "  ✆ remote" if s.get("rc") else ""   # single-width: an emoji miscounts in fzf
        title = s.get("name") or "untitled"
        tag = PREFIX.get(s["host"], "")
        if tag and not title.startswith(tag):
            title = tag + title
        when = s.get("last") or s.get("startedAt", 0)
        seen = age(when)
        facts = (f"{s['host']:<{hostw}}{kind:<13}{st:<10}{seen:>4} ago"
                 f"     started {age(s.get('startedAt', 0))}{rc}")
        card = f"{mark} {title}\n   {DIM}{facts}{R}"
        b = bucket(when)
        if b != group:
            # a heading is its own item, otherwise fzf paints the selection bar
            # down it as part of the card that follows
            group = b
            items.append("\t".join(
                ["", "heading", "", "", "", b,
                 f"{GREY}{b} {'─' * max(4, 52 - len(b))}{R}"]))
        hidden = [s["host"], kind, st, s.get("sessionId") or "",
                  s.get("cwd") or "~", (s.get("name") or "-").replace("\t", " ")]
        items.append("\t".join(hidden + [card]))
    return items


def collect(flags):
    with ThreadPoolExecutor() as ex:
        rows = [s for b in ex.map(lambda h: fetch(h, flags), HOSTS) for s in b]
        if "--all" in flags:  # closed sessions live only in their transcripts
            live = {s.get("sessionId") for s in rows}
            for b in ex.map(history, HOSTS):
                rows += [s for s in b if s["sessionId"] not in live]
    # an untitled transcript is a session that never went anywhere, so skip it
    rows = [s for s in rows if (s.get("name") or "").strip() not in ("", "-")]
    # most recently active first, so a session that just replied jumps to the top
    rows.sort(key=lambda s: -(s.get("last") or s.get("startedAt", 0)))
    return rows


def snapshot(flags):
    """Rows for a repaint: fresh if the snapshot aged out and nobody else is
    already fetching, otherwise the last known good set."""
    try:
        fresh = time.time() - os.path.getmtime(SNAP) < REFRESH
    except OSError:
        fresh = False
    if not fresh:
        try:
            fd = os.open(BUSY, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
        except OSError:
            fd = None                      # another repaint is already fetching
        if fd is not None:
            try:
                rows = collect(flags)
                with open(SNAP, "w") as f:
                    json.dump(rows, f)
                return rows
            finally:
                os.close(fd)
                try:
                    os.remove(BUSY)
                except OSError:
                    pass
    try:
        with open(SNAP) as f:
            return json.load(f)
    except Exception:
        return collect(flags)


def ticker(port, key, flags):
    """Push a reload into fzf every REFRESH seconds via its HTTP control port."""
    me = shlex.quote(os.path.abspath(sys.argv[0]))
    action = f"reload-sync({me} --lines {flags})".encode()
    while True:
        time.sleep(REFRESH)
        try:
            urllib.request.urlopen(urllib.request.Request(
                f"http://127.0.0.1:{port}", data=action, headers={"x-api-key": key}), timeout=3)
        except Exception:
            return  # fzf is gone, so is the reason to tick


def push(port, key, action):
    """Send an action to a running fzf through its control port."""
    if not port:
        return
    try:
        urllib.request.urlopen(urllib.request.Request(
            f"http://127.0.0.1:{port}", data=action.encode(),
            headers={"x-api-key": key}), timeout=3)
    except Exception:
        pass


def main_new():
    in_new_window("mac", f"{shlex.quote(os.path.abspath(sys.argv[0]))} --new")
    tile_windows(2.5)


def free_port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def main():
    args = sys.argv[1:]
    if args[:1] == ["--preview"]:
        return preview(*args[1:7])
    flags = "-a" if "-a" in args else ""
    if args[:1] == ["--header-click"]:
        if os.environ.get("FZF_CLICK_HEADER_LINE") == "13":
            main_new()
        return
    if args[:1] == ["--spawn-new"]:   # open the questions in their own window
        in_new_window("mac", f"{shlex.quote(os.path.abspath(sys.argv[0]))} --new")
        return tile_windows(2.5)   # the picker outlives the spawn, so grid from here
    if args[:1] == ["--new"]:
        return new_session(collect("--json"))
    if args[:1] == ["--open"]:
        return open_session(*args[1:6])
    if args[:1] == ["--lines"]:  # reload hook: emit the raw list, nothing else
        print("\0".join(rows_to_lines(snapshot("--json --all" if flags else "--json"))), end="")
        return
    while picker(args, flags):   # sessions open in their own window; this one stays
        pass


def picker(args, flags):
    """Draw the list once. Returns True to draw it again, False to quit."""
    rows = collect("--json --all" if flags else "--json")
    live = sum(1 for s in rows if s.get("state") in ("working", "blocked"))
    rc_n = sum(1 for s in rows if s.get("rc"))
    # sized for the narrower pane so the frame survives the preview opening
    cols = shutil.get_terminal_size((100, 24)).columns
    pane = max(34, int(cols * 0.60) - 2)          # list pane with the preview open
    gutter = max(len(m) for m in LOGO + [f"v{version()}"]) + 2
    width = max(34, min(pane - gutter - 5, 78))   # leaves room for the [X]
    who, tier = account(), plan()
    act = f"{len(rows)} sessions · {live} active · {rc_n} remote"
    new_plain = "+ New session   (click, or ctrl-n)"
    body = panel(width, [
        ("ACCOUNT", [(f"◆ {who}", f"{ORANGE}◆{R} {who}"),
                     (tier, f"{B}{YELLOW}{tier}{R}")]),
        ("SESSIONS", [(act, f"{B}{len(rows)}{R}{DIM} sessions · {R}{GREEN}{live}{R}"
                            f"{DIM} active · {R}{GREEN}{rc_n}{R}{DIM} remote{R}")]),
        ("STATS", stats_rows()),
        ("LIMITS", limits_line()),
        ("NEW", [(new_plain, f"{B}{ORANGE}+ New session{R}   {DIM}(click, or ctrl-n){R}")]),
    ])
    mark = LOGO + [f"v{version()}"]          # logo beside the panel, version under it
    gut = max(len(m) for m in mark) + 2
    rows_out = [f"{ORANGE if i < len(LOGO) else GREY}{mark[i]}{R}{' ' * (gut - len(mark[i]))}{l}"
                if i < len(mark) else f"{' ' * gut}{l}"
                for i, l in enumerate(body)]
    head = "\n".join(rows_out + ["", HEADER_COLS, " "])

    lines = rows_to_lines(rows)
    if "-l" in args or not sys.stdout.isatty():
        print(head.split("\n")[-1], *(l.split("\t")[6] for l in lines), sep="\n")
        return False

    me = shlex.quote(os.path.abspath(sys.argv[0]))
    # fzf's footer only spans the list pane once the preview opens, so the
    # clickable control goes first and never gets truncated away
    # a button here would sit far from the preview and show even with nothing
    # open, so the footer only states the keys
    footer = f"{DIM}enter opens    ctrl-n starts one    esc or ← closes the preview{R}"
    sel = os.path.join(tempfile.gettempdir(), f"csessions-sel-{os.getpid()}")
    PICK = f"execute-silent(: > {sel})+change-pointer(┃)+show-preview"
    port, key = free_port(), os.urandom(8).hex()
    os.environ["FZF_API_KEY"] = key
    os.environ["CS_PORT"], os.environ["CS_SEL"] = str(port), sel
    threading.Thread(target=ticker, args=(port, key, flags), daemon=True).start()
    # click-header is the button; --listen lets the ticker push periodic reloads
    pick = subprocess.run(
        ["fzf", "--delimiter=\t", "--with-nth=7", "--read0", "--marker= ", "--marker-multi-line=   ", "--gap=1", "--gap-line= ", "--header=" + head, "--no-sort", "--reverse",
         "--ansi", "--pointer=┃", "--prompt=search ",
         "--color=header:regular,fg:252,fg+:209:bold,pointer:209,prompt:245,border:240,bg+:-1,gutter:-1",
         "--border=rounded", "--info=inline-right", f"--listen={port}",
         "--footer", footer, "--footer-border=none",
         # NEW is handled after fzf exits: become() would inherit fzf's piped
         # stdout, leaving the spawned session without a terminal
         "--bind", f"ctrl-n:execute-silent({me} --spawn-new)",
         # only the button row (header line 4) opens the new-session picker
"--bind", f"click-header:execute-silent({me} --header-click)",
         "--bind", f"ctrl-r:reload-sync({me} --lines {flags})",
         # Preview stays shut until you pick a row. It is opened only by real
         # input, never by `focus`: the 5s reload re-sorts rows, which moves the
         # cursor and fires focus on its own.
         # open in place: exiting fzf and relaunching it is what made the
         # window blank out and look like a restart
         "--bind", f"enter:execute-silent({me} --open {{1}} {{2}} {{3}} {{4}} {{5}})",
         "--bind", f"double-click:execute-silent({me} --open {{1}} {{2}} {{3}} {{4}} {{5}})",
         # picking a row arms selection: pointer appears, preview opens
         "--bind", f"start:execute-silent(rm -f {sel})",
         "--bind", f"left-click:{PICK}", "--bind", f"up:up+{PICK}",
         "--bind", f"down:down+{PICK}", "--bind", f"ctrl-p:up+{PICK}",
         "--bind", f"page-up:page-up+{PICK}", "--bind", f"page-down:page-down+{PICK}",
         # esc drops back to browse mode (scroll freely, nothing highlighted);
         # pressing it again with nothing selected quits
         "--bind", f"left:execute-silent(rm -f {sel})+change-pointer( )+hide-preview",
         "--bind", f'esc:transform:if [ -f {sel} ]; then '
                   f'echo "execute-silent(rm -f {sel})+change-pointer( )+hide-preview"; '
                   f'else echo abort; fi',
         # scrolling is browsing, not picking, so it keeps its default move-only behaviour
         "--preview", f"{me} --preview {{1}} {{2}} {{3}} {{4}} {{5}} {{6}}",
         "--preview-window=hidden,right,40%,wrap,border-left"],
        input="\0".join(lines), stdout=subprocess.PIPE, text=True).stdout
    out = [l for l in pick.splitlines() if l.strip()]
    if not out:
        return False          # esc quits
    return False


if __name__ == "__main__":
    main()
